# Copy this file to .env and fill in what you need. Everything is optional for local use.

# Server
PORT=4000
PUBLIC_URL=http://localhost:4000
NODE_ENV=production
# Long random string. If empty, one is generated and stored in data/.jwt-secret
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Demo mode shows OTP codes on screen and enables one-tap demo logins.
# Set to false before real users sign up.
DEMO_MODE=true

# First admin account (created on first start / npm run seed)
ADMIN_EMAIL=admin@itenary.com
ADMIN_PASSWORD=Admin@12345

# AI concierge (Yatri). Without a key the built-in engine is used.
# You can also paste the key in Admin → Settings.
ANTHROPIC_API_KEY=

# WhatsApp Business Cloud API for OTP delivery (authentication template with one {{1}} code parameter + copy-code button)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Where the SQLite database and uploads live
DATA_DIR=data

# Web-app origins allowed to call the API when the site is hosted separately (Vercel). '*' allows any.
CORS_ORIGIN=*

# --- Web app build (Vercel) ---
# URL of the API server when the web app is hosted on a different domain, e.g. https://itenary-api.onrender.com
# Leave empty when the API server also serves the web app (local use, Docker, Render-only).
VITE_API_URL=
